# App Configuration
DEBUG=false
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# File Upload Limits
MAX_FILE_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30

# Default Financial Parameters
DEFAULT_DISCOUNT_RATE=0.05
